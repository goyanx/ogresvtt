AI_DM_DEFAULT_BACKEND=ollama

# Ollama defaults used by sidecar when request values are empty
AI_DM_OLLAMA_ENDPOINT=http://localhost:11434
AI_DM_OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
# Sidecar Ollama HTTP timeouts (seconds)
AI_DM_OLLAMA_TIMEOUT_SECONDS=300
AI_DM_OLLAMA_CONNECT_TIMEOUT_SECONDS=10
AI_DM_OLLAMA_WRITE_TIMEOUT_SECONDS=30
AI_DM_OLLAMA_POOL_TIMEOUT_SECONDS=30

# Grok defaults used by sidecar when request values are empty
XAI_API_KEY=
AI_DM_GROK_MODEL=grok-3-mini

# SQLite and admin
AI_DM_DB_PATH=ai_dm/data/dm.sqlite
AI_DM_ADMIN_ALLOW_WRITE=false

# Agent loop controls
AI_DM_MAX_QUERY_ROUNDS=4
AI_DM_MAX_RETRIES=2
